{
  "name": "demo-dapp-e2e",
  "private": true,
  "type": "module",
  "description": "A tiny XRPL dapp using @crossmarkio/sdk, and its e2e tests written with xrplwright",
  "scripts": {
    "start": "node server.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@crossmarkio/sdk": "0.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "xrplwright": "*",
    "xrpl": "5.3.0"
  }
}
