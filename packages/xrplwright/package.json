{
  "name": "xrplwright",
  "version": "0.1.0",
  "description": "Playwright end-to-end testing for XRP Ledger dapps: a programmable browser wallet that signs and submits for real, plus ledger helpers",
  "keywords": [
    "xrpl",
    "xrp",
    "xrp-ledger",
    "playwright",
    "e2e",
    "testing",
    "crossmark",
    "gemwallet",
    "wallet",
    "dapp",
    "web3"
  ],
  "license": "MIT",
  "author": "Szymon Droś",
  "homepage": "https://github.com/szymondros/xrplwright#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/szymondros/xrplwright.git",
    "directory": "packages/xrplwright"
  },
  "bugs": {
    "url": "https://github.com/szymondros/xrplwright/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./init": {
      "types": "./dist/init/init.d.ts",
      "default": "./dist/init/init.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "xrplwright": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "playwright test",
    "readme": "node scripts/readme.mjs",
    "prepack": "npm run readme && npm run build"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "ripple-keypairs": "3.1.0",
    "xrpl": "5.3.0"
  },
  "devDependencies": {
    "@crossmarkio/sdk": "0.4.0",
    "@gemwallet/api": "^3.8.0",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
